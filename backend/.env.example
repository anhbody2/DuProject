# Used when running the backend outside Docker (npm run start:dev).
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=food_marketplace
DB_LOGGING=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Refresh tokens (POST /auth/refresh). Empty secret = derived from JWT_SECRET.
# Once the frontend refreshes on 401, lower JWT_EXPIRES_IN to e.g. 15m.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Uploaded files (avatars), served at /api/uploads. Defaults to ./uploads
# UPLOAD_DIR=

# Mail for forgot-password codes. Leave SMTP_HOST empty to log codes to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=658536029731-j5a5jfkrg91lq57798qgei5g889pkoiq.apps.googleusercontent.com
SMTP_PASSWORD=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
MAIL_FROM=

# Social login. Leave a provider empty to hide its button.
# Google: OAuth client (Web) at console.cloud.google.com, with your site under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Facebook: app at developers.facebook.com with the "Facebook Login" product; add your domain to App Domains.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# VietMap (maps.vietmap.vn). Leave empty to disable address search / use the default map tiles.
# VIETMAP_API_KEY stays on the server (autocomplete, place, reverse geocoding).
VIETMAP_API_KEY=
# Sent to browsers for map tiles. Use a key restricted to your domain in the VietMap console.
VIETMAP_TILE_KEY=

# Business rules
DELIVERY_FEE_PER_STORE=15000
COMMISSION_RATE=0.1

# Initial admin created by the seeder
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
