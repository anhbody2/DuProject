# Used when running the backend outside Docker (npm run start:dev).
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=food_marketplace
DB_LOGGING=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Refresh tokens (POST /auth/refresh). Empty secret = derived from JWT_SECRET.
# Once the frontend refreshes on 401, lower JWT_EXPIRES_IN to e.g. 15m.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Uploaded files (avatars), served at /api/uploads. Defaults to ./uploads
# UPLOAD_DIR=

# Mail for forgot-password codes. Leave both SMTP_HOST and GMAIL_REFRESH_TOKEN empty
# to log codes to the console instead.
# Gmail with OAuth2: set SMTP_USER to the Gmail address plus the three GMAIL_* values
# (OAuth client at console.cloud.google.com, refresh token with the https://mail.google.com/ scope).
# Other SMTP servers: set SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Social login. Leave a provider empty to hide its button.
# Google: OAuth client (Web) at console.cloud.google.com, with your site under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Facebook: app at developers.facebook.com with the "Facebook Login" product; add your domain to App Domains.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# VietMap (maps.vietmap.vn). Leave empty to disable address search / use the default map tiles.
# VIETMAP_API_KEY stays on the server (autocomplete, place, reverse geocoding).
VIETMAP_API_KEY=
# Sent to browsers for map tiles. Use a key restricted to your domain in the VietMap console.
VIETMAP_TILE_KEY=

# Business rules
DELIVERY_FEE_PER_STORE=15000
COMMISSION_RATE=0.1

# Initial admin created by the seeder
ADMIN_USERNAME=admin123
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=1234568@A
