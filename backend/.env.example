# Used when running the backend outside Docker (npm run start:dev).
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=food_marketplace
DB_LOGGING=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Business rules
DELIVERY_FEE_PER_STORE=15000
COMMISSION_RATE=0.1

# Initial admin created by the seeder
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
