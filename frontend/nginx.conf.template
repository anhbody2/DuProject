server {
  listen 3000;
  root /usr/share/nginx/html;

  # The browser calls the relative /api/...; forward it to the NestJS API.
  location /api/ {
    # Image uploads are capped at 5 MB by the API (uploads.controller.ts) and ImageUpload;
    # leave room for the multipart envelope. Keep this above that limit or nginx answers 413.
    client_max_body_size 6m;
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Chat (Socket.IO): same backend, but upgraded to a WebSocket and kept open.
  location /api/socket.io/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
  }

  # Hashed build output never changes: cache it for a year.
  location /static/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Client-side routes (/menu, /account, ...) all serve the SPA shell.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
