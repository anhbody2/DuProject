# Copy to .env.local to override. All optional.

# Where the Vite dev server proxies /api (dev and `vite preview` only).
BACKEND_URL=http://localhost:3000

# API base URL used by axios. Leave unset to use the proxied relative /api (recommended).
# To call the backend directly instead, set it and add this origin to the backend's CORS_ORIGIN.
# VITE_API_URL=http://localhost:3000/api

# Display-only mirror of the backend's DELIVERY_FEE_PER_STORE.
# VITE_DELIVERY_FEE_PER_STORE=15000
